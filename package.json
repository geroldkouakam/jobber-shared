{
  "version": "0.0.1",
  "license": "MIT",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "description": "Helpers library for Jobber app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf build",
    "build:cjs": "NODE_ENV=production BABEL_ENV=cjs babel src --presets=./scripts/babel-preset.js --extensions .ts,.tsx --ignore src/**/*.specs.tsx --out-dir build/cjs --source-maps",
    "build:esm": "NODE_ENV=production BABEL_ENV=esm babel src --presets=./scripts/babel-preset.js --extensions .ts,.tsx --ignore src/**/*.specs.tsx --out-dir build/esm --source-maps",
    "build:types": "tsc  --outDir build/src",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types && node scripts/build-package.js"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "keywords": [],
  "name": "@geroldkouakam/jobber-shared",
  "author": "Gerold Kouakam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geroldkouakam/jobber-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "build/src"
  ],
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    },
    "./icons": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js"
    }
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.0.3",
    "cloudinary": "^2.7.0",
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.5",
    "typescript": "^5.8.3",
    "winston": "^3.17.0",
    "winston-elasticsearch": "^0.19.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
